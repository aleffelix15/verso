# Mercado Pago: necessários em produção para checkout e webhook.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Domínio público HTTPS da loja em produção; localhost é permitido em desenvolvimento.
PUBLIC_SITE_URL=http://localhost:5173

# Supabase: credenciais de servidor. Nunca use prefixo VITE_ nem exponha no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: credencial para integrar um provedor real de frete.
FREIGHT_API_TOKEN=
